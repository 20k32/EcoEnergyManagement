<?xml version="1.0" encoding="utf-8"?><Page x:Class="EcoEnergyManagement.UI.ReportsPage"    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">        <Grid.RowDefinitions>            <RowDefinition Height="Auto"/>            <RowDefinition Height="Auto"/>            <RowDefinition Height="*"/>        </Grid.RowDefinitions>        <StackPanel Grid.Row="0" Background="{ThemeResource SystemAccentColor}" Padding="20">            <TextBlock Text="Reports and Analysis" FontSize="24" FontWeight="Bold" Foreground="White"/>            <TextBlock Text="Table 1.7 Format - Resource Consumption and Expenses" FontSize="14" Foreground="White" Margin="0,8,0,0"/>        </StackPanel>        <StackPanel Grid.Row="1" Padding="20" Orientation="Vertical" Spacing="10">            <StackPanel Orientation="Horizontal" Spacing="15">                <StackPanel Orientation="Vertical" Spacing="5">                    <TextBlock Text="Year:" FontSize="12" FontWeight="Bold"/>                    <ComboBox x:Name="YearComboBox" Width="120" SelectionChanged="YearComboBox_SelectionChanged"/>                </StackPanel>                <StackPanel Orientation="Vertical" Spacing="5">                    <TextBlock Text="Structural Unit:" FontSize="12" FontWeight="Bold"/>                    <ComboBox x:Name="UnitComboBox" Width="300" DisplayMemberPath="Name" SelectionChanged="UnitComboBox_SelectionChanged"/>                </StackPanel>                <Button Content="Load Report" Padding="15,10" Click="LoadReport_Click" VerticalAlignment="Bottom"/>                <Button Content="Summary (All Units)" Padding="15,10" Click="LoadSummary_Click" VerticalAlignment="Bottom"/>            </StackPanel>            <StackPanel Orientation="Horizontal" Spacing="10">                <TextBlock x:Name="ReportTitleText" Text="" FontSize="14" FontWeight="SemiBold"/>                <ProgressRing x:Name="ProgressRing" IsActive="False" Height="30" Width="30"/>            </StackPanel>            <TextBlock x:Name="ErrorText" Text="" Foreground="Red" TextWrapping="Wrap"/>        </StackPanel>        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">            <ItemsControl x:Name="ReportDataGrid" Margin="20,0,20,20">                <ItemsControl.ItemsPanel>                    <ItemsPanelTemplate>                        <StackPanel Orientation="Vertical" Spacing="0"/>                    </ItemsPanelTemplate>                </ItemsControl.ItemsPanel>                <ItemsControl.ItemTemplate>                    <DataTemplate>                        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="200"/>                                <ColumnDefinition Width="80"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="60"/>                                <ColumnDefinition Width="80"/>                            </Grid.ColumnDefinitions>                            <TextBlock Grid.Column="0" Text="{Binding Indicator}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>                            <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>                            <TextBlock Grid.Column="2" Text="{Binding January}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="3" Text="{Binding February}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="4" Text="{Binding March}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="5" Text="{Binding April}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="6" Text="{Binding May}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="7" Text="{Binding June}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="8" Text="{Binding July}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="9" Text="{Binding August}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="10" Text="{Binding September}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="11" Text="{Binding October}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="12" Text="{Binding November}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="13" Text="{Binding December}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>                            <TextBlock Grid.Column="14" Text="{Binding Total}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" Foreground="{ThemeResource SystemAccentColor}"/>                        </Grid>                    </DataTemplate>                </ItemsControl.ItemTemplate>            </ItemsControl>        </ScrollViewer>    </Grid></Page>