<?xml version="1.0" encoding="utf-8"?><Page x:Class="EcoEnergyManagement.UI.InventoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Background="{ThemeResource SystemAccentColor}" Padding="20"><TextBlock Text="Organizational Inventory" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="Structural Units and Available Resources" FontSize="14" Foreground="White" Margin="0,8,0,0"/></StackPanel><Grid Grid.Row="1" Padding="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Vertical" Spacing="10"><TextBlock Text="Organizational Structure" FontSize="16" FontWeight="SemiBold"/><TreeView x:Name="UnitsTreeView" Height="400"/></StackPanel><StackPanel Grid.Column="1" Orientation="Vertical" Spacing="10" Margin="20,0,0,0"><TextBlock Text="Unit Details" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Name:" FontSize="12" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock x:Name="UnitNameText" Text="-" FontSize="11"/><TextBlock Text="Type:" FontSize="12" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock x:Name="UnitTypeText" Text="-" FontSize="11"/><TextBlock Text="Available Resources:" FontSize="12" FontWeight="Bold" Margin="0,10,0,0"/><ListView x:Name="ResourcesListView" Height="200"/></StackPanel></Grid><StackPanel Grid.Row="2" Padding="20" Background="LightGray"><TextBlock x:Name="ErrorText" Foreground="Red" Text=""/></StackPanel></Grid></Page>