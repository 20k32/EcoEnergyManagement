<?xml version="1.0" encoding="utf-8"?><Page x:Class="EcoEnergyManagement.UI.DataEntryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Background="{ThemeResource SystemAccentColor}" Padding="20"><TextBlock Text="Data Entry and Generation" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="Automatic generation or manual edit of consumption and production data" FontSize="14" Foreground="White" Margin="0,8,0,0"/></StackPanel><ScrollViewer Grid.Row="1"><StackPanel Padding="20" Orientation="Vertical" Spacing="20"><StackPanel Orientation="Vertical" Spacing="10"><TextBlock Text="Data Generation Controls" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><StackPanel Orientation="Vertical" Spacing="5"><TextBlock Text="Year:"/><ComboBox x:Name="YearComboBox" Width="100" SelectionChanged="YearComboBox_SelectionChanged"/></StackPanel><StackPanel Orientation="Vertical" Spacing="5"><TextBlock Text="Structural Unit:"/><ComboBox x:Name="UnitComboBox" Width="250" DisplayMemberPath="Name" SelectionChanged="UnitComboBox_SelectionChanged"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"><Button x:Name="GenConsumptionBtn" Content="Generate Consumption Data" Padding="15,10" Click="GenerateConsumption_Click"/><Button x:Name="GenTemperatureBtn" Content="Generate Temperature Data" Padding="15,10" Click="GenerateTemperature_Click"/><Button x:Name="GenServiceOutputBtn" Content="Generate Service Output" Padding="15,10" Click="GenerateServiceOutput_Click"/></StackPanel><Button x:Name="GenAllBtn" Content="Generate ALL Data (2016-2026)" Padding="15,10" Background="Orange" Click="GenerateAll_Click" Margin="0,10,0,0"/></StackPanel><StackPanel Orientation="Vertical" Spacing="10"><TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="" Foreground="Green" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" Text="" Foreground="Red" TextWrapping="Wrap"/><ProgressRing x:Name="ProgressRing" IsActive="False"/></StackPanel></StackPanel></ScrollViewer></Grid></Page>